# Copy to .env for local development (Pterodactyl uses panel variables instead).

# Required: your TheMovieDB API key.
# Get one free at https://www.themoviedb.org/settings/api
# Works with a v3 API key (32 hex chars) OR a v4 read access token (long JWT).
TMDB_API_KEY=

# Optional: base URL of the embed/streaming player. No trailing slash.
PLAYER_BASE_URL=https://111movies.net

# Optional: port for local dev. In Pterodactyl this is provided as SERVER_PORT.
PORT=3000

# --- Swift Servers (torrent streaming through the site's own player) ---------
# Torrent sources. Nothing is built in; Swift Servers stay hidden until one is set.
# Stremio stream addon URL(s) - the manifest URL you'd install in Stremio
# (Torrentio-style addons). Separate several with spaces.
STREMIO_ADDONS=https://torrentio.strem.fun/manifest.json https://torrentio.strem.fun/lite/manifest.json https://thepiratebay-plus.strem.fun/manifest.json http://stremio-yts.herokuapp.com/manifest.json
# Jackett / Prowlarr Torznab feed URL(s), space separated, and their API key.
TORZNAB_URLS=
TORZNAB_APIKEY=
# Disk space for the torrent cache, torrents streaming at once, transcoding on/off.
TORRENT_CACHE_GB=20
TORRENT_MAX_ACTIVE=3
TORRENT_TRANSCODE=1
# More options (TORRENT_PORT, TORRENT_UPLOAD_KBPS, ...) are listed in the README.

# Automatic updates: check GitHub every few minutes and restart into new
# versions when nobody is streaming (also pulls on every boot).
SELF_UPDATE=0
SELF_UPDATE_MINUTES=5
