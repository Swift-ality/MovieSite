# Copy to .env for local development (Pterodactyl uses panel variables instead).

# Required: your TheMovieDB API key.
# Get one free at https://www.themoviedb.org/settings/api
# Works with a v3 API key (32 hex chars) OR a v4 read access token (long JWT).
TMDB_API_KEY=

# Optional: base URL of the embed/streaming player. No trailing slash.
PLAYER_BASE_URL=https://111movies.net

# Optional: port for local dev. In Pterodactyl this is provided as SERVER_PORT.
PORT=3000
