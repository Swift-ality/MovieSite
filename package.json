{
  "name": "movie-stream-site",
  "version": "1.0.0",
  "description": "Search movies, TV & anime and stream them through embeddable players or torrents (Stremio/Torrentio-style).",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "webtorrent": "^2.8.5",
    "webrtc-polyfill": "file:vendor/webrtc-polyfill"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2"
  },
  "overrides": {
    "webrtc-polyfill": "$webrtc-polyfill",
    "uint8-util": "2.2.6"
  }
}
